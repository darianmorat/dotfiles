[user]
   name = Darian Toledo
   email = dariantoledo@duck.com

[core]
   editor = nvim
   pager = delta

[interactive]
    diffFilter = delta --color-only

[delta]
	features = dark
   syntax-theme = none
   line-numbers = true
   file-style = "yellow"
   file-decoration-style = omit
   plus-emph-style = "green reverse"
   minus-emph-style = "red reverse"
   line-numbers-plus-style = "green"
   line-numbers-minus-style = "red"
   line-numbers-zero-style = "grey"
   hunk-header-line-number-style = "cyan"

[delta "dark"]
   dark = true
   plus-style = "green #2d3a2a"
   minus-style = "red #3a292b"
   line-numbers-left-style = "#575757"
   line-numbers-right-style = "#575757"
   hunk-header-decoration-style = "#575757 ul"

[delta "light"]
   light = true
   plus-style = "green #c3e2c5"
   minus-style = "red #edc2c6"
   line-numbers-left-style = "#7f7f7f"
   line-numbers-right-style = "#7f7f7f"
   hunk-header-decoration-style = "#7f7f7f ul"

[alias]
   sdiff = -c delta.side-by-side=true diff
