@theme "styles"

configuration {
   modi:                "drun,run";
   terminal:            "foot";
   case-sensitive:      false;
   show-icons:          true;
   icon-theme:          "Papirus";
   dpi:                 1;

   run, drun {
      fallback-icon:    "Terminal";
   }

   display-drun:        "Apps";
   display-run:         "Run";
   eh:                  2;
   drun-show-actions:   false;

   kb-element-next:     "";
   kb-element-prev:     "";
   kb-mode-next:        "Tab";
}
