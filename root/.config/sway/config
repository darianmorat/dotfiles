# Sync env to D-Bus/systemd (portals, popups)
exec dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP=sway

# Start XDG autostart .desktop applications
exec dex --autostart --environment sway

# Set modifier key
set $mod Mod1

# Drag floating windows
floating_modifier $mod

# Font and scaling
font pango:Inter Display 13.5
output eDP-1 scale 1

# Window options
title_align center
smart_borders on
workspace_layout tabbed

default_border normal 1
default_floating_border normal 1

# Mouse idle hide
seat * hide_cursor 5000
seat * hide_cursor when-typing enable

# Title bar style
client.focused #181818 #131313 #FFFFFF #FFFFFF #181818
client.focused_inactive #181818 #131313 #FFFFFF #181818 #181818
client.unfocused #181818 #131313 #686868 #181818 #181818
client.urgent #161616 #801717 #FFFFFF #801717 #801717

# Lock after 10 min and screen off 5 min after
exec swayidle -w \
   timeout 600 'swaylock -f' \
   timeout 900 'swaymsg "output * power off"' resume 'swaymsg "output * power on"' \
   before-sleep 'swaylock -f'

# Theming
exec ~/.config/theme-toggle init

# Start applications
exec gammastep
exec mako
exec helium-browser
exec waybar

# Volume controls
bindsym XF86AudioRaiseVolume exec "pamixer -i 5 && notify-send -a 'OSD' -h string:x-canonical-private-synchronous:osd -h int:value:$(pamixer --get-volume) 'Volume'"
bindsym XF86AudioLowerVolume exec "pamixer -d 5 && notify-send -a 'OSD' -h string:x-canonical-private-synchronous:osd -h int:value:$(pamixer --get-volume) 'Volume'"
bindsym XF86AudioMute exec "pamixer -t && if pamixer --get-mute | grep -q 'true'; then notify-send -a 'OSD' -h string:x-canonical-private-synchronous:osd 'Muted'; else notify-send -a 'OSD' -h string:x-canonical-private-synchronous:osd -h int:value:$(pamixer --get-volume) 'Volume'; fi"

# Brightness controls
bindsym XF86MonBrightnessUp exec "brightnessctl set +10% && notify-send -a 'OSD' -h string:x-canonical-private-synchronous:osd -h int:value:$(brightnessctl -m | cut -d, -f4 | tr -d '%') 'Brightness'"
bindsym XF86MonBrightnessDown exec "brightnessctl set 10%- && notify-send -a 'OSD' -h string:x-canonical-private-synchronous:osd -h int:value:$(brightnessctl -m | cut -d, -f4 | tr -d '%') 'Brightness'"

# Media controls
bindsym XF86AudioPlay exec "playerctl play-pause"

# Print assignation
bindsym Print exec "QT_SCALE_FACTOR=1.20 flameshot gui"

# Theme toggle
bindsym $mod+Shift+period exec ~/.config/theme-toggle

# Toggle tray
exec waybar -c ~/.config/waybar/tray/config.json -s ~/.config/waybar/tray/style.css
bindsym $mod+Shift+v exec pkill -SIGUSR1 -f 'waybar.*tray/config\.json'

# Launch terminal
bindsym $mod+l exec foot

# Launch File Manager
bindsym $mod+period exec nemo

# Kill focused window
bindsym $mod+Shift+d kill

# Lock screen
bindsym $mod+Shift+l exec swaylock -f

# App launcher
bindsym $mod+Shift+Ctrl+u exec rofi -show drun

# Clipboard history
exec wl-paste --watch cliphist store
bindsym $mod+Shift+Ctrl+m exec cliphist list | rofi -dmenu -p Clipboard | cliphist decode | wl-copy

# Change focus
bindsym $mod+i focus left
bindsym $mod+j focus down
bindsym $mod+k focus up
bindsym $mod+o focus right

# Move focused window
bindsym $mod+Shift+i move left
bindsym $mod+Shift+j move down
bindsym $mod+Shift+k move up
bindsym $mod+Shift+o move right

# Toggle orientation
bindsym $mod+v split toggle

# Fullscreen
bindsym $mod+Shift+f fullscreen toggle

# Change layout
bindsym $mod+d layout tabbed
bindsym $mod+f layout toggle split

# Toggle tiling / floating
bindsym $mod+x floating toggle
bindsym $mod+Shift+x focus mode_toggle

# Scratchpad
bindsym $mod+Shift+c move scratchpad
bindsym $mod+c scratchpad show

# Workspaces
set $ws1 "1"
set $ws2 "2"
set $ws3 "3"
set $ws4 "4"

# Switch workspace
bindsym $mod+w workspace number $ws1
bindsym $mod+e workspace number $ws2
bindsym $mod+r workspace number $ws3
bindsym $mod+t workspace number $ws4

# Move container to workspace
bindsym $mod+Shift+w move container to workspace number $ws1
bindsym $mod+Shift+e move container to workspace number $ws2
bindsym $mod+Shift+r move container to workspace number $ws3
bindsym $mod+Shift+t move container to workspace number $ws4

# Go to most recent workspace
bindsym $mod+m workspace back_and_forth

# Resize mode
mode "RS" {
   bindsym i resize grow width 10 px or 10 ppt
   bindsym o resize shrink width 10 px or 10 ppt
   bindsym j resize shrink height 10 px or 10 ppt
   bindsym k resize grow height 10 px or 10 ppt

   bindsym c move position center

   bindsym q mode "default"
   bindsym Escape mode "default"
}

bindsym $mod+Shift+m mode "RS"

# Input Keyboard
input * {
   xkb_layout "us"
   xkb_options "compose:menu"
}

# Input Mouse 
input "10182:480:GXTP7863:00_27C6:01E0_Touchpad" {
   dwt disabled
   tap enabled
   natural_scroll enabled
   middle_emulation enabled
}
input "10182:480:GXTP7863:00_27C6:01E0_Mouse" {
   natural_scroll enabled
   scroll_factor 1.0
}
