(defcfg 
   process-unmapped-keys yes
   concurrent-tap-hold yes
)

(defvar
   tap-timeout 150
   hold-timeout 150

   tt $tap-timeout
   ht $hold-timeout
)

(defchordsv2
  (d k) caps 50 all-released ()
)

(defsrc)
(deflayermap (default)
   w (tap-hold-release $tt $ht w (layer-while-held mdia-layer))
   e (tap-hold-release $tt $ht e (layer-while-held rsym-layer))
   o (tap-hold-release $tt $ht o (layer-while-held func-layer))
   i (tap-hold-release $tt $ht i (layer-while-held lsym-layer))

   s (tap-hold-release $tt $ht s lalt)
   d (tap-hold-release $tt $ht d lsft)
   c (tap-hold-release $tt $ht c lctl)
   l (tap-hold-release $tt $ht l ralt)
   k (tap-hold-release $tt $ht k rsft)
   m (tap-hold-release $tt $ht m rctl)

   f (tap-hold-release $tt $ht f (layer-while-held nav-layer))
   j (tap-hold-release $tt $ht j (layer-while-held numb-layer))

   v (tap-hold-release $tt $ht v XX)
   n (tap-hold-release $tt $ht n (layer-while-held term-layer))

   lalt (tap-hold-release $tt $ht esc (layer-while-held acct-layer))
   spc (tap-hold-release $tt $ht spc (layer-while-held curs-layer))

   q (tap-hold-release $tt $ht q XX)
   r (tap-hold-release $tt $ht r XX)
   t (tap-hold-release $tt $ht t XX)
   y (tap-hold-release $tt $ht y XX)
   u (tap-hold-release $tt $ht u XX)
   p (tap-hold-release $tt $ht p XX)
   a (tap-hold-release $tt $ht a XX)
   g (tap-hold-release $tt $ht g XX)
   h (tap-hold-release $tt $ht h XX)
   ; (tap-hold-release $tt $ht S-; XX)
   z (tap-hold-release $tt $ht z XX)
   x (tap-hold-release $tt $ht x XX)
   b (tap-hold-release $tt $ht b XX)
   , (tap-hold-release $tt $ht , XX)
   . (tap-hold-release $tt $ht . XX)
   / (tap-hold-release $tt $ht ; XX)

   ___ XX
)

(deflayermap (nav-layer)
   y del
   u A-S-C-u 
   i left
   o right

   h bspc
   j down
   k up
   l ret

   n pgup
   m pgdn
   , home
   . end

   s lalt
   d lsft
   lalt lctl
   spc tab

   a (layer-switch nav-layer)
   f (layer-switch default)

   ___ XX
)

(deflayermap (numb-layer)
   a 0

   f 1
   d 2
   s 3

   v 4
   c 5
   x 6

   r 7
   e 8
   w 9

   lalt bspc

   k rsft
   l ralt
   spc rctl


   ; (layer-switch numb-layer)
   j (layer-switch default)

   ___ XX
)

(deflayermap (lsym-layer)
   q S-3
   w S-6
   e S-4
   r S-7
   t S-1

   a grv
   s S-'
   d '
   f S-5
   g S-2

   x [
   c ]
   v S-grv
   b \

   spc rctl
   j (layer-while-held lsym-punc)

   ___ XX
)

(deflayermap (lsym-punc)
   t (macro menu S-1 S-1)

   ___ _
)

(deflayermap (rsym-layer)
   y S-\
   u -
   i S-9
   o S-0
   p S-8

   h S--
   j =
   k S-[
   l S-]
   ; /

   n S-/
   m S-=
   , S-,
   . S-.

   lalt lctl
   f (layer-while-held rsym-punc)

   ___ XX
)
 
(deflayermap (rsym-punc)
   n (macro menu S-/ S-/)

   ___ _
)

(deflayermap (func-layer)
   f f1
   d f2
   s f3

   v f4
   c f5
   x f6

   r f7
   e f8
   w f9

   q f10
   a f11
   z f12

   lalt lalt
   spc rctl

   ___ XX
)

(deflayermap (mdia-layer)
   u mute
   i vold
   o volu

   j f24
   k pp
   l prtsc

   m A-S-C-m
   , brdown
   . brup

   ___ XX
)

(deflayermap (term-layer)
   c (macro C-f12 50 c)
   d (macro C-f12 50 d)

   f (macro C-f12 50 f)
   r (macro C-f12 50 r)

   s (macro C-f12 50 s)
   w (macro C-f12 50 w)

   ___ XX
)

(deflayermap (acct-layer)
   a (fork (macro menu ' a) (macro menu (unshift ') S-a) (lsft rsft))
   e (fork (macro menu ' e) (macro menu (unshift ') S-e) (lsft rsft))
   i (fork (macro menu ' i) (macro menu (unshift ') S-i) (lsft rsft))
   o (fork (macro menu ' o) (macro menu (unshift ') S-o) (lsft rsft))
   u (fork (macro menu ' u) (macro menu (unshift ') S-u) (lsft rsft))

   n (fork (macro menu S-grv n) (macro menu S-grv S-n) (lsft rsft))

   d lsft
   k rsft
   s (layer-while-held acct-diae)

   ___ XX
)

(deflayermap (acct-diae)
   u (fork (macro menu S-' u) (macro menu S-' S-u) (lsft rsft))

   ___ _
)

(deflayermap (curs-layer)
   j mlft
   u mmid
   l mrgt

   w (mwheel-left  100 120)
   i (mwheel-down  100 120)
   o (mwheel-up    100 120)
   r (mwheel-right 100 120)

   s (movemouse-accel-left  3 400 1 10)
   d (movemouse-accel-down  3 400 1 10)
   e (movemouse-accel-up    3 400 1 10)
   f (movemouse-accel-right 3 400 1 10)

   lalt lctl
   k (layer-while-held curs-slow)

   ___ XX
)

(deflayermap (curs-slow)
   s (movemouse-left  12 4)
   d (movemouse-down  12 4)
   e (movemouse-up    12 4)
   f (movemouse-right 12 4)
)
